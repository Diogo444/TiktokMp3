:8080 {
	@compressible {
		not path /api/download*
	}
	encode @compressible zstd gzip

	@api path /api /api/*
	@api_preflight {
		path /api /api/*
		method OPTIONS
	}

	handle @api {
		header {
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers *
			Access-Control-Max-Age "86400"
		}

		respond @api_preflight 204

		reverse_proxy tiktokmp3-backend:3000 {
			flush_interval -1
			transport http {
				dial_timeout 30s
				response_header_timeout 30s
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		reverse_proxy tiktokmp3-frontend:80
	}
}
